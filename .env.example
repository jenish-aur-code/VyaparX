# ========================================================
# VYAPARX - EMAIL SMTP CONFIGURATION (FOR REAL OTP EMAILS)
# ========================================================

# OPTION 1: GMAIL (RECOMMENDED & EASIEST - 1 MINUTE SETUP)
# 1. Go to your Google Account -> Security -> 2-Step Verification (turn ON if OFF).
# 2. Go to "App passwords" (https://myaccount.google.com/apppasswords).
# 3. Create an app named "VyaparX" and copy the 16-character password.
# 4. Fill below:
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=abcd efgh ijkl mnop
EMAIL_FROM="VyaparX Security" <your_email@gmail.com>

# OPTION 2: CUSTOM SMTP (Hostinger, Brevo, SendGrid, Zoho, etc.)
# EMAIL_HOST=smtp.yourdomain.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=support@yourdomain.com
# EMAIL_PASSWORD=your_smtp_password
# EMAIL_FROM="VyaparX" <support@yourdomain.com>

# Session / JWT Secret Key
JWT_SECRET=vyaparx_secret_session_key_change_in_production_2026

# Standalone Server Port (Optional)
PORT=5000
